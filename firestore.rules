rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedOwner() {
      return isVerifiedUser() && request.auth.token.email == 'krishnaladva25@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedOwner() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'loyaltyPoints', 'totalOrders', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'loyaltyPoints', 'totalOrders', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.loyaltyPoints is int && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 1000000
        && data.totalOrders is int && data.totalOrders >= 0 && data.totalOrders <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'address', 'dietaryPreferences', 'updatedAt'])
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('address' in data) || (data.address is string && data.address.size() <= 240))
        && (!('dietaryPreferences' in data) || (data.dietaryPreferences is string && data.dietaryPreferences.size() <= 200))
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.grantedAt is timestamp;
    }

    function isValidMenuItem(data, itemId) {
      return data.keys().hasAll(['id', 'name', 'category', 'description', 'imageUrl', 'available', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'category', 'subcategory', 'showcaseSection', 'description',
          'price', 'discountPrice', 'dietaryType', 'imageUrl', 'ingredients',
          'dietaryTags', 'customisationOptions', 'prepMinutes', 'calories',
          'available', 'stockStatus', 'isPopular', 'isBestseller', 'isNew',
          'isNewArrival', 'isRecommended', 'updatedAt'
        ])
        && data.id == itemId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 50
        && (!('subcategory' in data) || (data.subcategory is string && data.subcategory.size() <= 80))
        && (!('showcaseSection' in data) || (data.showcaseSection is string && data.showcaseSection.size() <= 80))
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 500
        && (!('price' in data) || data.price == null || (data.price is number && data.price >= 0 && data.price <= 100000))
        && (!('discountPrice' in data) || data.discountPrice == null || (data.discountPrice is number && data.discountPrice >= 0 && data.discountPrice <= 100000))
        && (!('dietaryType' in data) || data.dietaryType in ['veg', 'non-veg'])
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 300
        && data.available is bool
        && (!('stockStatus' in data) || data.stockStatus in ['in_stock', 'low_stock', 'out_of_stock'])
        && (!('ingredients' in data) || (data.ingredients is list && data.ingredients.size() <= 25 && (data.ingredients.size() == 0 || data.ingredients[0] is string)))
        && (!('dietaryTags' in data) || (data.dietaryTags is list && data.dietaryTags.size() <= 10 && (data.dietaryTags.size() == 0 || data.dietaryTags[0] is string)))
        && (!('customisationOptions' in data) || (data.customisationOptions is list && data.customisationOptions.size() <= 10 && (data.customisationOptions.size() == 0 || data.customisationOptions[0] is map)))
        && (!('prepMinutes' in data) || (data.prepMinutes is int && data.prepMinutes >= 1 && data.prepMinutes <= 240))
        && (!('calories' in data) || (data.calories is int && data.calories >= 0 && data.calories <= 5000))
        && (!('isPopular' in data) || data.isPopular is bool)
        && (!('isBestseller' in data) || data.isBestseller is bool)
        && (!('isNew' in data) || data.isNew is bool)
        && (!('isNewArrival' in data) || data.isNewArrival is bool)
        && (!('isRecommended' in data) || data.isRecommended is bool)
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'itemCount', 'total', 'status', 'paymentStatus', 'orderType', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'customerName', 'itemCount', 'total', 'status', 'paymentStatus', 'paymentReference', 'orderType', 'deliveryAddress', 'notes', 'createdAt', 'updatedAt'])
        && data.id == orderId
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80
        && data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 100
        && data.total is number && data.total > 0 && data.total <= 1000000
        && data.status in ['confirmed', 'preparing', 'ready', 'out_for_delivery', 'completed', 'cancelled']
        && data.paymentStatus in ['verified', 'pending', 'refunded']
        && data.orderType in ['delivery', 'pickup', 'dine_in']
        && (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 80))
        && (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 240))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReservation(data, reservationId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'date', 'time', 'partySize', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'date', 'time', 'partySize', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.id == reservationId
        && isValidId(data.userId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.time is string && data.time.size() == 5 && data.time.matches('^\\d{2}:\\d{2}$')
        && data.partySize is int && data.partySize >= 1 && data.partySize <= 20
        && data.status in ['confirmed', 'seated', 'completed', 'cancelled']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll(['id', 'userId', 'authorName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'authorName', 'rating', 'comment', 'dishId', 'createdAt'])
        && data.id == reviewId
        && isValidId(data.userId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 500
        && (!('dishId' in data) || (data.dishId is string && data.dishId.size() <= 128))
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().loyaltyPoints == 0
        && incoming().totalOrders == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if false;

      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && (isOwner(userId) || isAdmin())
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'address', 'dietaryPreferences', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isAdmin()
        && isValidAdminMarker(incoming(), userId)
        && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    match /menuItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isAdmin()
        && isValidMenuItem(incoming(), itemId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isAdmin()
        && isValidMenuItem(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'subcategory', 'showcaseSection', 'description',
          'price', 'discountPrice', 'dietaryType', 'imageUrl', 'ingredients',
          'dietaryTags', 'customisationOptions', 'prepMinutes', 'calories',
          'available', 'stockStatus', 'isPopular', 'isBestseller', 'isNew',
          'isNewArrival', 'isRecommended', 'updatedAt'
        ]);
      allow delete: if isValidId(itemId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isVerifiedUser()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isBootstrappedOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isVerifiedUser()
        && isValidOrder(incoming(), orderId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'confirmed'
        && incoming().paymentStatus in ['verified', 'pending']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isValidId(orderId)
        && isValidOrder(incoming(), orderId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().userId)
            && !(existing().status in ['completed', 'cancelled'])
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId) && isVerifiedUser()
        && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isBootstrappedOwner() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(reservationId) && isVerifiedUser()
        && isValidReservation(incoming(), reservationId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reservationId)
        && isValidReservation(incoming(), reservationId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(existing().userId)
            && !(existing().status in ['completed', 'cancelled'])
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId) && isVerifiedUser()
        && isValidReview(incoming(), reviewId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(reviewId) && isVerifiedUser()
        && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
